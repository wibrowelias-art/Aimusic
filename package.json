{
  "name": "ambient-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Ambient Lab: one-click calm, sparse, original ambient piano pieces.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "vitest run --config vitest.measure.config.ts",
    "samples:fetch": "node scripts/fetch-samples.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^1.72.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

# Only needed for the optional "Music AI" engine. The built-in generator and the piano are free and need none of this.
# Copy this file to .env and fill in the key. .env is git-ignored: never commit a key.

# ElevenLabs API key (Music API needs a paid plan). Stays on the local dev server, never in the page.
ELEVENLABS_API_KEY=

# Optional. Price used for the estimate before each generation, USD per minute of audio.
# ELEVENLABS_USD_PER_MINUTE=0.15

# Optional. 1 = no API calls at all: a built-in test signal comes back instead (free).
# STYLE_LAB_MOCK=1

# Optional. 1 = let other devices on the network use the backend (they could spend your credits).
# STYLE_LAB_ALLOW_REMOTE=1
